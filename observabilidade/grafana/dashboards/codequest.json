          "rawQuery": true,
          "rawSql": "SELECT fase_id AS fase, count(*) AS \"conclusões\"\nFROM fase_concluida\nGROUP BY fase_id\nORDER BY split_part(fase_id, '-', 1), (regexp_replace(fase_id, '.*fase', ''))::int"
